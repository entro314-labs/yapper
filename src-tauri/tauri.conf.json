{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windbag",
  "version": "0.2.0",
  "identifier": "com.entro314.windbag",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Windbag",
        "width": 1240,
        "height": 820,
        "minWidth": 880,
        "minHeight": 580,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "SocialNetworking",
    "copyright": "Copyright \u00a9 2026 Dominikos Pritis",
    "shortDescription": "Compose, schedule and publish across social platforms.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/*"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBREY3M0I2NEU3QzcwM0UKUldRK2NIeE90blBmZWtNaDBIczZCNGRTRzMxd0taMUV6cjVLRXozeUlQTm5KdXhrd0hGUlo2WGsK",
      "endpoints": [
        "https://github.com/entro314-labs/windbag-releases/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "io.github.entro314-labs"
        ]
      }
    }
  }
}
