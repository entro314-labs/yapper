# The shared secret the desktop app sends on POST /api/media. Generate one with
# `openssl rand -hex 32` and paste the same value into Windbag →
# Settings → Web deployment.
WINDBAG_UPLOAD_TOKEN=

# Cloudflare R2, via its S3-compatible API. The bucket holds ONLY transient
# publish media: Meta fetches an attachment from here while it builds the media
# container, and nothing reads it afterwards.
#
# The app uploads straight to R2 with a presigned URL that /api/media signs with
# these credentials, so the key needs Object Read & Write on the bucket. No CORS
# rule is needed: the upload comes from the desktop app's Rust side, not from a
# browser.
#
# Set a lifecycle rule on the bucket to expire objects after a day or two. That
# is the only cleanup — the app deliberately does not delete on its own, because
# a video container is processed asynchronously and may be fetched minutes after
# the post was accepted.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional, and preferred in production. With a public r2.dev address or a
# custom domain bound to the bucket — media.windbag.social, say — Meta fetches
# straight from R2 and this deployment never serves the bytes or pays the egress.
# Without it, media is served back through /m/<key> on this origin.
R2_PUBLIC_BASE_URL=

# Optional. Your Meta app secrets, comma-separated — one per Meta app whose
# data-deletion callback points here (the Facebook/Instagram app and the Threads
# app each have their own). Used ONLY to verify the signature on that callback;
# without them the route reports that it is not configured rather than
# accepting an unverified request.
META_APP_SECRETS=
